	(text "J21 pins 1/2 = +12 V and 3/4 = GND is a PLACEHOLDER: wire to match the chosen 12 V/10 A brick's DIN pinout (C13)."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "6c1de53a-5936-4dd6-bce4-ee3ce441b288")
	)
	(text "Q20 is a P-MOSFET used as an ideal-diode-style reverse-polarity switch: drain to the fused input, source to +12V, gate pulled to GND through R20 and clamped by D21."
		(exclude_from_sim no)
		(at 30 280.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
