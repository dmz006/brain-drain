	(text "J21 pins 1/2 = +12 V and 3/4 = GND is a PLACEHOLDER: wire to match the chosen 12 V/10 A brick's DIN pinout (C13)."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
