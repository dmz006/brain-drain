		(uuid "b18c6e47-2441-4ff4-8b11-8a44cd467242")
	)
	(text "Q20 is a P-MOSFET used as an ideal-diode-style reverse-polarity switch: drain to the fused input, source to +12V, gate pulled to GND through R20 and clamped by D21."
		(exclude_from_sim no)
		(at 30 280.5 0)
		(effects
			(font
