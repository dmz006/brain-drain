	(text "Hub B: upstream on CM5 USB3-1. Downstream ports 1,2 -> bays 3,4. Ports 3,4 disabled by PRT_DIS straps (verify the strap resistor value against USB5744 §3.4.2)."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
