	(text "Hub B: upstream on CM5 USB3-1. Downstream ports 1,2 -> bays 3,4. Ports 3,4 disabled by PRT_DIS straps (verify the strap resistor value against USB5744 §3.4.2)."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "5054529d-bafa-41fd-8501-8f5314558ad8")
	)
	(text "No SPI ROM and no SMBus pull-ups: the hub runs its internal ROM defaults. RESET_N has a pull-up only; add an RC if strap timing (1 ms hold) is a concern."
		(exclude_from_sim no)
		(at 30 280.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "88d3be64-2e5e-4076-9234-84d02d2de7fd")
	)
	(text "Crystal: 25 MHz, CL 20 pF per datasheet table 10-10; 33 pF load caps assume ~3 pF stray, adjust to the chosen crystal."
		(exclude_from_sim no)
		(at 30 285 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
