	(text "GPIO_VREF is tied to the CM5's own 3.3 V output (pins 84/86) for 3.3 V GPIO signalling, per datasheet §4.2."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c331343e-d6cd-5a04-bced-9c735bc255a2")
	)
	(text "PMIC_Enable and PWR_Button are left floating (internal pull-ups). nRPIBOOT goes to jumper J6."
		(exclude_from_sim no)
		(at 30 280.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "05040f8e-42dd-5992-aad5-59e8b0de3442")
	)
	(text "LED_nACT is an open-drain 20 mA output on the CM5: it sinks D2 directly. GPIO26 sinks D3 (software drives it low to light)."
		(exclude_from_sim no)
		(at 30 285 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "640418c5-df9f-582a-92e2-f65e22ce419a")
	)
	(text "microSD power goes through U52 so the CM5 can power-cycle the card on reboot via SD_PWR_ON, matching the CM5IO reference (which uses an RT9742)."
		(exclude_from_sim no)
		(at 30 289.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ae56624d-273e-544b-88ae-7b5300c5e017")
	)
	(text "Ethernet dropped (C22). The CM5 wireless variant's PCB antenna is on the short module edge that carries MH1; that edge sits on the board's left edge with an 8 mm copper-free strip under it and no metal within 10 mm (CM5 datasheet 4.1.2)."
		(exclude_from_sim no)
		(at 30 294 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cc5be94f-b76a-54f2-9282-7f0d633994cd")
	)
	(text "USB-C is a device port (rpiboot / gadget). As on the CM5IO, CC1/CC2 go straight to the CM5, which presents the sink pull-downs itself; VBUS is not connected (the board is powered from 12 V). USB_OTG_ID floats = device."
		(exclude_from_sim no)
		(at 30 298.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "bf403722-f128-5dd9-9015-7d043836f0ca")
	)
	(embedded_fonts no)
)
