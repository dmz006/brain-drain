	(text "ASM1153E runs from 5 V only: VBUS_LDO -> VCCO (3.3 V, feeds VCC/VCCU/VCCS/VCCTXL) and VCCIN -> LXI switcher -> 1.05 V core (VDD/VDDU/VDDS). Datasheet notes VCCIN must be tied to 5 V."
		(exclude_from_sim no)
		(at 30 276 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7e185ade-d2a7-57c8-9007-77a4237777a8")
	)
	(text "Clock straps GPIO3/GPIO7 left at their internal pull-up default (11) = 30 MHz crystal, so no strap resistors. GPIO6 default = I2C mode, no SPI ROM."
		(exclude_from_sim no)
		(at 30 280.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
